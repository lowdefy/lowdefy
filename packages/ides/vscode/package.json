{
  "name": "lowdefy-vscode",
  "version": "7.2.0",
  "private": true,
  "license": "Apache-2.0",
  "displayName": "Lowdefy Developer Tools",
  "description": "Lowdefy Developer Tools",
  "publisher": "lowdefy",
  "engines": {
    "vscode": "^1.101.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy"
  },
  "categories": [],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "Lowdefy Developer Tools",
      "properties": {
        "lowdefyDevTools.localServerPort": {
          "type": "number",
          "default": 3000,
          "description": "Specifies the local server port of the running Lowdefy dev server."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lowdefy",
          "title": "Lowdefy",
          "icon": "media/lowdefy.svg"
        }
      ]
    },
    "views": {
      "lowdefy": [
        {
          "id": "lowdefyAppTree",
          "name": "App Tree",
          "visibility": "visible"
        },
        {
          "id": "lowdefyDataInspector",
          "name": "Data Inspector",
          "visibility": "visible"
        }
      ]
    },
    "languages": [
      {
        "id": "yaml-lowdefy",
        "aliases": [
          "yaml-lowdefy"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ]
      },
      {
        "id": "nunjucks",
        "aliases": [
          "nunjucks"
        ],
        "extensions": [
          ".njk"
        ]
      }
    ],
    "grammars": [
      {
        "language": "yaml-lowdefy",
        "scopeName": "source.yaml.lowdefy.injection",
        "injectTo": [
          "source.yaml"
        ],
        "path": "./syntaxes/yaml-lowdefy.injection.json"
      },
      {
        "language": "nunjucks",
        "scopeName": "source.nunjucks",
        "path": "./syntaxes/nunjucks.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "transpile-syntaxes": "js-yaml syntaxes/yaml-lowdefy.injection.yaml > syntaxes/yaml-lowdefy.injection.json",
    "build": "pnpm run transpile-syntaxes && node esbuild.cjs",
    "build:prod": "node esbuild.cjs --production",
    "build:watch": "node esbuild.cjs --watch",
    "build:watch-syntaxes": "nodemon -e yaml --watch syntaxes --exec pnpm run transpile-syntaxes",
    "pretest": "pnpm run build && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test:skipped": "node ./dist/test/runTest.js",
    "vscode:prepublish": "pnpm run build:prod",
    "check-types": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.101.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "glob": "14.0.4",
    "js-yaml": "5.5.0",
    "mocha": "12.0.3",
    "nodemon": "3.1.14",
    "typescript": "7.0.2"
  }
}
