{
  "name": "lowdefy",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "Lowdefy CLI",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "bin": "./dist/index.js",
  "files": [
    "dist/*"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json --copy-files && node scripts/generateDevTools.mjs",
    "clean": "rm -rf dist && rm -rf .lowdefy",
    "start": "node ./dist/index.js",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:fixture": "vitest run --config vitest.fixture.config.js"
  },
  "dependencies": {
    "@lowdefy/ajv": "7.1.0",
    "@lowdefy/errors": "7.1.0",
    "@lowdefy/helpers": "7.1.0",
    "@lowdefy/logger": "7.1.0",
    "@lowdefy/node-utils": "7.1.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vercel/nft": "1.10.2",
    "axios": "1.20.0",
    "commander": "14.0.3",
    "dotenv": "16.3.1",
    "semver": "7.7.4",
    "tar": "7.5.21",
    "uuid": "14.0.0",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@lowdefy/server-dev": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
