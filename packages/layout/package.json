{
  "name": "@lowdefy/layout",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "utils"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json && pnpm copyfiles",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.yaml\" -e \"./src/**/*.snap\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/block-utils": "7.1.0",
    "@lowdefy/helpers": "7.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@lowdefy/block-dev": "7.1.0",
    "@lowdefy/vite-yaml-plugin": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@testing-library/dom": "8.19.1",
    "@testing-library/react": "13.4.0",
    "@testing-library/user-event": "14.6.1",
    "copyfiles": "2.4.1",
    "jest-serializer-html": "7.1.0",
    "jsdom": "19.0.0",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
