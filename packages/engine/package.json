{
  "name": "@lowdefy/engine",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:compiled": "vitest run --config vitest.compiled.config.js",
    "test:full": "vitest run --config vitest.full.config.js"
  },
  "dependencies": {
    "@lowdefy/errors": "7.1.0",
    "@lowdefy/helpers": "7.1.0",
    "@lowdefy/operators": "7.1.0"
  },
  "devDependencies": {
    "@lowdefy/actions-core": "7.1.0",
    "@lowdefy/build": "7.1.0",
    "@lowdefy/e2e-utils": "7.1.0",
    "@lowdefy/operators-js": "7.1.0",
    "@lowdefy/operators-mql": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "jsdom": "19.0.0",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
