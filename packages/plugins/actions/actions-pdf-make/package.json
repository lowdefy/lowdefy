{
  "name": "@lowdefy/actions-pdf-make",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy actions",
    "lowdefy plugin",
    "pdfmake",
    "pdf"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./actions": "./dist/actions.js",
    "./schemas": "./dist/schemas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "pdfmake": "0.2.7"
  },
  "devDependencies": {
    "@lowdefy/node-utils": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32"
  },
  "publishConfig": {
    "access": "public"
  }
}
