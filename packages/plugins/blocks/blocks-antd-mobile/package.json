{
  "name": "@lowdefy/blocks-antd-mobile",
  "version": "5.3.0",
  "license": "Apache-2.0",
  "description": "antd-mobile blocks for Lowdefy mobile apps.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy blocks",
    "antd-mobile"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    "./*": "./dist/*",
    "./blocks": "./dist/blocks.js",
    "./e2e": "./dist/e2e.js",
    "./metas": "./dist/metas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json && pnpm copyfiles",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.yaml\" -e \"./src/**/*.snap\"",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@lowdefy/block-utils": "5.3.0",
    "@lowdefy/helpers": "5.3.0"
  },
  "peerDependencies": {
    "antd-mobile": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lowdefy/block-dev-e2e": "5.3.0",
    "@lowdefy/e2e-utils": "5.3.0",
    "@playwright/test": "1.59.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "antd-mobile": "5.42.1",
    "copyfiles": "2.4.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
