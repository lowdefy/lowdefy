{
  "name": "@lowdefy/blocks-files",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "description": "Lowdefy provider-neutral file upload and download blocks.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy blocks",
    "file upload",
    "file download",
    "lowdefy plugin"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": "./dist/*",
    "./blocks": "./dist/blocks.js",
    "./metas": "./dist/metas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json && pnpm copyfiles",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.snap\"",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@lowdefy/block-utils": "7.2.0",
    "@lowdefy/blocks-antd": "7.2.0",
    "@lowdefy/errors": "7.2.0",
    "@lowdefy/helpers": "7.2.0"
  },
  "peerDependencies": {
    "antd": ">=6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@lowdefy/block-dev-e2e": "7.2.0",
    "@playwright/test": "1.65.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "antd": "6.7.0",
    "copyfiles": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
