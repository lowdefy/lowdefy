{
  "name": "@lowdefy/blocks-table",
  "version": "6.0.0",
  "license": "Apache-2.0",
  "description": "Table block for Lowdefy: a virtualised, keyboard-accessible data table on TanStack Table.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy blocks",
    "table",
    "data grid",
    "lowdefy plugin"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    },
    {
      "name": "Johann Möller",
      "url": "https://github.com/JohannMoller"
    },
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": "./dist/*",
    "./blocks": "./dist/blocks.js",
    "./metas": "./dist/metas.js",
    "./e2e": "./dist/e2e.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json && pnpm copyfiles",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.snap\"",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "bench": "node bench/run.mjs",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@lowdefy/block-utils": "6.0.0",
    "@lowdefy/blocks-antd": "6.0.0",
    "@lowdefy/helpers": "6.0.0",
    "@lowdefy/nunjucks": "6.0.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "dayjs": "1.11.20"
  },
  "peerDependencies": {
    "antd": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@jest/globals": "28.1.3",
    "@lowdefy/block-dev-e2e": "6.0.0",
    "@lowdefy/e2e-utils": "6.0.0",
    "@playwright/test": "1.59.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "@vitejs/plugin-react": "6.0.2",
    "antd": "6.6.5",
    "copyfiles": "2.4.1",
    "jest": "28.1.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vite": "8.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
