{
  "name": "@lowdefy/blocks-table",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "description": "Table block for Lowdefy: a virtualised, keyboard-accessible data table on TanStack Table.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy blocks",
    "table",
    "data grid",
    "lowdefy plugin"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    },
    {
      "name": "Johann Möller",
      "url": "https://github.com/JohannMoller"
    },
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": "./dist/*",
    "./blocks": "./dist/blocks.js",
    "./metas": "./dist/metas.js",
    "./e2e": "./dist/e2e.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json && pnpm copyfiles",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.snap\"",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "e2e:enrichment": "playwright test --config e2e/enrichment/playwright.config.js",
    "bench": "node bench/run.mjs",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/block-utils": "7.2.0",
    "@lowdefy/blocks-antd": "7.2.0",
    "@lowdefy/helpers": "7.2.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "dayjs": "1.11.23"
  },
  "peerDependencies": {
    "antd": ">=6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@lowdefy/block-dev-e2e": "7.2.0",
    "@lowdefy/e2e-utils": "7.2.0",
    "@playwright/test": "1.65.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@vitejs/plugin-react": "6.3.0",
    "antd": "6.7.0",
    "copyfiles": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
