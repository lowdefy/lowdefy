{
  "name": "@lowdefy/icons-react-icons",
  "version": "6.0.0",
  "license": "Apache-2.0",
  "description": "Lowdefy icon set with every react-icons 5.6.0 icon under its react-icons name. A migration aid for apps moving to Lucide.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy icons",
    "react-icons",
    "lowdefy plugin"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    },
    {
      "name": "Stephanie Smit",
      "url": "https://github.com/StephanieJKS"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./dist/*",
    "./iconSets": "./dist/iconSets.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json && node scripts/generateIconData.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@jest/globals": "28.1.3",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "jest": "28.1.3",
    "react-icons": "5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
