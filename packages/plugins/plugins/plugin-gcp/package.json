{
  "name": "@lowdefy/plugin-gcp",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "Lowdefy Google Cloud Platform connections.",
  "homepage": "https://lowdefy.com",
  "lowdefy": {
    "serverExternalPackages": [
      "@google-cloud/storage"
    ]
  },
  "keywords": [
    "lowdefy",
    "lowdefy plugin",
    "google cloud storage"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./connections": "./dist/connections.js",
    "./types": "./dist/types.js",
    "./connections/*": "./dist/connections/*",
    "./*": "./dist/*"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "@lowdefy/errors": "7.1.0",
    "@lowdefy/helpers": "7.1.0"
  },
  "devDependencies": {
    "@lowdefy/ajv": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
