{
  "name": "@lowdefy/plugin-better-auth",
  "version": "5.5.1",
  "license": "Apache-2.0",
  "description": "Lowdefy providers, API auth strategies, and admin steps for the BetterAuth engine.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy plugin"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "lowdefy": {
    "pluginApiVersion": 1
  },
  "exports": {
    "./auth/providers": "./dist/auth/providers.js",
    "./auth/strategies": "./dist/auth/strategies.js",
    "./steps": "./dist/steps.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@lowdefy/errors": "5.5.1",
    "@lowdefy/helpers": "5.5.1",
    "better-auth": "1.7.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@jest/globals": "28.1.3",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "jest": "28.1.3",
    "jest-environment-node": "28.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
