{
  "name": "@lowdefy/plugin-aws",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "lowdefy": {
    "serverExternalPackages": [
      "@aws-sdk/client-s3"
    ]
  },
  "keywords": [
    "lowdefy",
    "lowdefy plugin"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    },
    {
      "name": "Stephanie Smit",
      "url": "https://github.com/StephanieJKS"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./connections": "./dist/connections.js",
    "./blocks": "./dist/blocks.js",
    "./metas": "./dist/metas.js",
    "./types": "./dist/types.js",
    "./connections/*": "./dist/connections/*",
    "./*": "./dist/*"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.yaml\" -e \"./src/**/*.snap\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/block-utils": "7.2.0",
    "@lowdefy/blocks-antd": "7.2.0",
    "@lowdefy/blocks-files": "7.2.0",
    "@lowdefy/errors": "7.2.0",
    "@lowdefy/helpers": "7.2.0",
    "@lowdefy/node-utils": "7.2.0",
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/s3-presigned-post": "3.1166.0",
    "@aws-sdk/s3-request-presigner": "3.1166.0",
    "undici": "8.12.4"
  },
  "peerDependencies": {
    "antd": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lowdefy/ajv": "7.2.0",
    "@lowdefy/vite-yaml-plugin": "7.2.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "antd": "6.7.0",
    "copyfiles": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
