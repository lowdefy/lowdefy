{
  "name": "@lowdefy/plugin-posthog",
  "version": "5.6.0",
  "license": "Apache-2.0",
  "description": "Lowdefy PostHog product analytics plugin: initialise posthog-js, capture events, identify people and groups, manage consent and read feature flags.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy actions",
    "lowdefy plugin",
    "posthog",
    "analytics"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    "./actions": "./dist/actions.js",
    "./schemas": "./dist/schemas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@lowdefy/helpers": "5.6.0",
    "posthog-js": "1.434.7"
  },
  "devDependencies": {
    "@jest/globals": "28.1.3",
    "@lowdefy/node-utils": "5.6.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "jest": "28.1.3",
    "jest-environment-jsdom": "28.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
