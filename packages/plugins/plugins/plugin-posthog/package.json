{
  "name": "@lowdefy/plugin-posthog",
  "version": "7.0.0",
  "license": "Apache-2.0",
  "description": "Lowdefy PostHog product analytics plugin: initialise posthog-js, capture events, identify people and groups, manage consent and read feature flags.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy actions",
    "lowdefy plugin",
    "posthog",
    "analytics"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./actions": "./dist/actions.js",
    "./schemas": "./dist/schemas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "e2e": "playwright test --config e2e/playwright.config.js",
    "e2e:ui": "playwright test --config e2e/playwright.config.js --ui",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/helpers": "7.0.0",
    "posthog-js": "1.434.7"
  },
  "devDependencies": {
    "@lowdefy/block-dev-e2e": "7.0.0",
    "@lowdefy/e2e-utils": "7.0.0",
    "@lowdefy/node-utils": "7.0.0",
    "@playwright/test": "1.59.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "jsdom": "19.0.0",
    "react": "18.2.0",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
