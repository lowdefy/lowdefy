{
  "name": "@lowdefy/operators-cron",
  "version": "6.0.0",
  "license": "Apache-2.0",
  "description": "Lowdefy cron operators: next and previous occurrences, human readable descriptions and validation of cron expressions.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy operator",
    "lowdefy plugin",
    "cron"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    "./operators/client": "./dist/operatorsClient.js",
    "./operators/server": "./dist/operatorsServer.js",
    "./schemas": "./dist/schemas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "TZ=UTC node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@lowdefy/helpers": "6.0.0",
    "@lowdefy/operators": "6.0.0",
    "cron-parser": "5.10.0",
    "cronstrue": "3.27.0"
  },
  "devDependencies": {
    "@lowdefy/node-utils": "6.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "jest": "28.1.3",
    "jest-environment-jsdom": "28.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
