{
  "name": "@lowdefy/operators-cron",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "description": "Lowdefy cron operators: next and previous occurrences, human readable descriptions and validation of cron expressions.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy operator",
    "lowdefy plugin",
    "cron"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./operators/client": "./dist/operatorsClient.js",
    "./operators/server": "./dist/operatorsServer.js",
    "./schemas": "./dist/schemas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/helpers": "7.2.0",
    "@lowdefy/operators": "7.2.0",
    "cron-parser": "5.10.4",
    "cronstrue": "3.39.0"
  },
  "devDependencies": {
    "@lowdefy/node-utils": "7.2.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "jsdom": "31.0.0",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
