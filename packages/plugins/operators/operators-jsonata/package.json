{
  "name": "@lowdefy/operators-jsonata",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "JSONata operators for Lowdefy",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "lowdefy operator",
    "lowdefy plugin",
    "jsonata"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Machiel van der Walt",
      "url": "https://github.com/machielvdw"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./operators/client": "./dist/operatorsClient.js",
    "./operators/server": "./dist/operatorsServer.js",
    "./schemas": "./dist/schemas.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../../.swcrc --cli-config-file ../../../../.swc-cli.json --copy-files",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/helpers": "7.1.0",
    "@lowdefy/operators": "7.1.0",
    "jsonata": "1.8.9"
  },
  "devDependencies": {
    "@lowdefy/node-utils": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
