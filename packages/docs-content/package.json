{
  "name": "@lowdefy/docs-content",
  "version": "5.5.1",
  "license": "Apache-2.0",
  "description": "Lowdefy documentation extracted as markdown for AI coding agents.",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "docs",
    "mcp"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git",
    "directory": "packages/docs-content"
  },
  "type": "module",
  "exports": {
    "./index.json": "./index.json",
    "./hazards.json": "./hazards.json",
    "./scripts/extractAgentDocs.js": "./scripts/extractAgentDocs.js",
    "./content/*": "./content/*"
  },
  "files": [
    "content/**",
    "hazards.json",
    "index.json",
    "scripts/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
