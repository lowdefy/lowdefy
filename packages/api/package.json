{
  "name": "@lowdefy/api",
  "version": "6.0.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./context/*": "./dist/context/*",
    "./routes/*": "./dist/routes/*"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:mongodb": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.mongodb.config.js"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@lowdefy/ajv": "6.0.0",
    "@lowdefy/build": "6.0.0",
    "@lowdefy/connection-smtp": "6.0.0",
    "@lowdefy/email-templates": "6.0.0",
    "@lowdefy/errors": "6.0.0",
    "@lowdefy/helpers": "6.0.0",
    "@lowdefy/node-utils": "6.0.0",
    "@lowdefy/nunjucks": "6.0.0",
    "@lowdefy/operators": "6.0.0",
    "@lowdefy/operators-js": "6.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "better-auth": "1.7.7",
    "jose": "^6.2.3",
    "mongodb-connection-string-url": "^7.0.2",
    "nodemailer": "10.0.13"
  },
  "devDependencies": {
    "@jest/globals": "28.1.3",
    "@lowdefy/connection-mongodb": "6.0.0",
    "@opentelemetry/api": "1.9.1",
    "@shelf/jest-mongodb": "4.3.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "jest": "28.1.3",
    "mongodb": "7.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
