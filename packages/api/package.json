{
  "name": "@lowdefy/api",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./context/*": "./dist/context/*",
    "./csp/*": "./dist/csp/*",
    "./routes/*": "./dist/routes/*"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:mongodb": "vitest run --config vitest.mongodb.config.js"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@lowdefy/ajv": "7.1.0",
    "@lowdefy/build": "7.1.0",
    "@lowdefy/connection-smtp": "7.1.0",
    "@lowdefy/email-templates": "7.1.0",
    "@lowdefy/errors": "7.1.0",
    "@lowdefy/helpers": "7.1.0",
    "@lowdefy/node-utils": "7.1.0",
    "@lowdefy/nunjucks": "7.1.0",
    "@lowdefy/operators": "7.1.0",
    "@lowdefy/operators-js": "7.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.7",
    "jose": "^6.2.3",
    "mongodb-connection-string-url": "^7.0.2",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@lowdefy/connection-mongodb": "7.1.0",
    "@lowdefy/plugin-better-auth": "7.1.0",
    "@opentelemetry/api": "1.9.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "mongodb": "7.2.0",
    "mongodb-memory-server-core": "9.2.0",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
