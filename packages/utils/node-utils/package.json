{
  "name": "@lowdefy/node-utils",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "description": "",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "utils"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../.swcrc --cli-config-file ../../../.swc-cli.json && pnpm copyfiles",
    "copyfiles": "copyfiles -u 1 \"./src/scripts/*\" dist",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/errors": "7.1.0",
    "@lowdefy/helpers": "7.1.0",
    "fs-extra": "11.3.4",
    "undici": "7.30.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "ajv": "8.20.0",
    "copyfiles": "2.4.1",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
