{
  "name": "@lowdefy/ai-utils",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./agents": "./dist/agents.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../.swcrc --cli-config-file ../../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.60",
    "@lowdefy/errors": "7.2.0",
    "@lowdefy/helpers": "7.2.0",
    "@lowdefy/node-utils": "7.2.0",
    "ai": "7.0.116",
    "glob": "13.0.6",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@lowdefy/ajv": "7.2.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
