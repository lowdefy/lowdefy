{
  "name": "@lowdefy/email-templates",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./notifications": "./dist/notifications.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../.swcrc --cli-config-file ../../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/helpers": "7.2.0",
    "@lowdefy/nunjucks": "7.2.0",
    "@react-email/render": "2.3.1",
    "markdown-it": "15.0.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
