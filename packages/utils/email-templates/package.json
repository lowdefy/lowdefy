{
  "name": "@lowdefy/email-templates",
  "version": "7.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./notifications": "./dist/notifications.js",
    "./types": "./dist/types.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../.swcrc --cli-config-file ../../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/helpers": "7.1.0",
    "@lowdefy/nunjucks": "7.1.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.10",
    "markdown-it": "14.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lowdefy/ajv": "7.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
