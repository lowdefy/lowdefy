{
  "name": "@lowdefy/block-utils",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "description": "Lowdefy Block Utils",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "utils"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "files": [
    "dist/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../.swcrc --cli-config-file ../../../.swc-cli.json && pnpm copyfiles && node scripts/writeHtmlCss.mjs",
    "clean": "rm -rf dist",
    "copyfiles": "copyfiles -u 1 \"./src/**/*\" dist -e \"./src/**/*.js\" -e \"./src/**/*.yaml\" -e \"./src/**/*.snap\"",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lowdefy/errors": "7.2.0",
    "@lowdefy/helpers": "7.2.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@lowdefy/ajv": "7.2.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "copyfiles": "2.4.1",
    "jest-serializer-html": "7.1.0",
    "jsdom": "31.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
