{
  "name": "@lowdefy/journey-headless",
  "version": "7.2.0",
  "license": "Apache-2.0",
  "description": "Lowdefy headless journeys: run a built app's pages on the client engine in Node, with no browser",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "testing",
    "journeys"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../../.swcrc --cli-config-file ../../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:fixture": "vitest run --config vitest.fixture.config.js"
  },
  "dependencies": {
    "@lowdefy/client-core": "7.2.0",
    "@lowdefy/engine": "7.2.0",
    "@lowdefy/errors": "7.2.0",
    "@lowdefy/helpers": "7.2.0",
    "@lowdefy/node-utils": "7.2.0",
    "@lowdefy/test-utils": "7.2.0"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "vitest": "4.1.12",
    "yaml": "2.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
