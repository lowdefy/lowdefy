  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "bin": {
    "lowdefy-build": "./dist/scripts/run.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dev": "./dist/indexDev.js",
    "./buildTestPage": "./dist/build/full/buildTestPage.js",
    "./dynamic": "./dist/dynamic/buildDynamicBlocks.js"
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json && node dist/scripts/generateDefaultTypes.js && node dist/scripts/generateDefaultMessages.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "start": "node dist/scripts/run.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:u": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=snapshots -- -u"
  },
