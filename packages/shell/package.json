{
  "name": "@lowdefy/shell",
  "version": "6.0.0",
  "license": "Apache-2.0",
  "description": "Lowdefy Shell - the Expo app every Lowdefy phone app is built from",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy",
    "react native",
    "expo"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "main": "expo-router/entry",
  "nativeVersion": 1,
  "files": [
    "app/*",
    "scripts/*",
    "src/*",
    "app.config.ts",
    "authCallbackIntentFilters.js",
    "babel.config.js",
    "checkShellConfig.js",
    "getPrivacyManifest.js",
    "metro.config.js",
    "native-fingerprint.json",
    "profiles.js",
    "readShellConfig.js",
    "runtimeVersion.js",
    "shell.dev.json",
    "shellVariant.js",
    "withExcludedNativeModules.js",
    "!**/*.test.*"
  ],
  "scripts": {
    "dayjs-locales": "node scripts/createDayjsLocales.mjs",
    "check:native-version": "node scripts/checkNativeVersion.mjs",
    "check:release-bundle": "node scripts/checkReleaseBundle.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "start": "expo start",
    "test": "jest && node --test fixtures/hello.test.mjs scripts/createDayjsLocales.test.mjs checkShellConfig.test.mjs profiles.test.mjs runtimeVersion.test.mjs shellVariant.test.mjs storeCompliance.test.mjs authCallbackIntentFilters.test.mjs scripts/checkNativeVersion.test.mjs",
    "type-manifest": "node scripts/createTypeManifest.mjs"
  },
  "dependencies": {
    "@expo/ui": "58.0.20",
    "@lowdefy/actions-core": "6.0.0",
    "@lowdefy/blocks-native": "6.0.0",
    "@lowdefy/client-core": "6.0.0",
    "@lowdefy/client-native": "6.0.0",
    "@lowdefy/engine": "6.0.0",
    "@lowdefy/helpers": "6.0.0",
    "@lowdefy/node-utils": "6.0.0",
    "@lowdefy/operators-change-case": "6.0.0",
    "@lowdefy/operators-cron": "6.0.0",
    "@lowdefy/operators-dayjs": "6.0.0",
    "@lowdefy/operators-diff": "6.0.0",
    "@lowdefy/operators-js": "6.0.0",
    "@lowdefy/operators-jsonata": "6.0.0",
    "@lowdefy/operators-mql": "6.0.0",
    "@lowdefy/operators-nunjucks": "6.0.0",
    "@lowdefy/operators-uuid": "6.0.0",
    "@lowdefy/operators-yaml": "6.0.0",
    "dayjs": "1.11.20",
    "expo": "58.0.14",
    "expo-clipboard": "58.0.3",
    "expo-camera": "58.0.10",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-font": "58.0.8",
    "expo-image": "58.0.15",
    "expo-linking": "58.0.13",
    "expo-local-authentication": "58.0.2",
    "expo-network": "58.0.3",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "expo-sensors": "58.0.4",
    "expo-splash-screen": "58.0.10",
    "expo-sqlite": "58.0.13",
    "expo-updates": "58.0.17",
    "expo-web-browser": "58.0.6",
    "jimp-compact": "0.16.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/plugin-transform-class-static-block": "7.29.7",
    "@expo/fingerprint": "0.21.5",
    "@jest/globals": "29.7.0",
    "@lowdefy/build": "6.0.0",
    "@lowdefy/logger": "6.0.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "babel-jest": "29.7.0",
    "babel-preset-expo": "58.0.17",
    "jest": "29.7.0",
    "test-renderer": "1.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
