// Generated by @lowdefy/shell native/withAppShortcuts.js. Do not edit.
//
// One App Intent for the app's shortcuts (mobile.shortcuts): Siri, Spotlight and the Shortcuts
// app offer "Open <shortcut> in <app>". The shortcuts are the app icon quick actions the shell sets
// from the app's server (expo-quick-actions), so this file holds no app data. Running one opens
// __SCHEME__://shortcut/<id>, which the shell routes like a quick action.

import AppIntents
import UIKit

@available(iOS 18.0, *)
struct LowdefyShortcutEntity: AppEntity {
  static var typeDisplayRepresentation: TypeDisplayRepresentation = "Shortcut"
  static var defaultQuery = LowdefyShortcutQuery()

  var id: String
  var title: String

  var displayRepresentation: DisplayRepresentation {
    DisplayRepresentation(title: "\(title)")
  }
}

@available(iOS 18.0, *)
struct LowdefyShortcutQuery: EntityQuery {
  @MainActor
  func entities(for identifiers: [String]) async throws -> [LowdefyShortcutEntity] {
    try await suggestedEntities().filter { identifiers.contains($0.id) }
  }

  @MainActor
  func suggestedEntities() async throws -> [LowdefyShortcutEntity] {
    (UIApplication.shared.shortcutItems ?? []).map {
      LowdefyShortcutEntity(id: $0.type, title: $0.localizedTitle)
    }
  }
}

@available(iOS 18.0, *)
struct OpenLowdefyShortcutIntent: AppIntent {
  static var title: LocalizedStringResource = "Open Shortcut"
  static var openAppWhenRun = true

  @Parameter(title: "Shortcut")
  var shortcut: LowdefyShortcutEntity

  @MainActor
  func perform() async throws -> some IntentResult & OpensIntent {
    var components = URLComponents()
    components.scheme = "__SCHEME__"
    components.host = "shortcut"
    components.path = "/\(shortcut.id)"
    return .result(opensIntent: OpenURLIntent(components.url!))
  }
}

@available(iOS 18.0, *)
struct LowdefyAppShortcuts: AppShortcutsProvider {
  static var appShortcuts: [AppShortcut] {
    AppShortcut(
      intent: OpenLowdefyShortcutIntent(),
      phrases: [
        "Open \(\.$shortcut) in \(.applicationName)",
        "\(.applicationName) \(\.$shortcut)",
      ],
      shortTitle: "Open",
      systemImageName: "arrow.up.forward.app"
    )
  }
}
