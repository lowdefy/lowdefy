{
  "name": "@lowdefy/reports",
  "version": "5.4.0",
  "license": "Apache-2.0",
  "description": "Server-side PDF and Excel report generation for Lowdefy from a closed document intermediate representation",
  "homepage": "https://lowdefy.com",
  "keywords": [
    "lowdefy"
  ],
  "bugs": {
    "url": "https://github.com/lowdefy/lowdefy/issues"
  },
  "contributors": [
    {
      "name": "Sam Tolmay",
      "url": "https://github.com/SamTolmay"
    },
    {
      "name": "Gerrie van Wyk",
      "url": "https://github.com/Gervwyk"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lowdefy/lowdefy.git"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "swc src --out-dir dist --config-file ../../.swcrc --cli-config-file ../../.swc-cli.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@lowdefy/actions-core": "5.4.0",
    "@lowdefy/engine": "5.4.0",
    "@lowdefy/errors": "5.4.0",
    "@lowdefy/helpers": "5.4.0",
    "@lowdefy/operators": "5.4.0",
    "exceljs": "4.4.0",
    "pdfmake": "0.3.11",
    "remark-gfm": "3.0.0",
    "remark-parse": "10.0.2",
    "unified": "10.1.2"
  },
  "devDependencies": {
    "@jest/globals": "28.1.3",
    "@lowdefy/build": "5.4.0",
    "@lowdefy/operators-js": "5.4.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.32",
    "@swc/jest": "0.2.39",
    "jest": "28.1.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
